<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- byob-artifact-host (the Servo helper) under the hardened runtime: SpiderMonkey's JIT maps
     executable memory with MAP_JIT, which needs allow-jit. byob itself needs no entitlements.
     Used by scripts/macos-bundle.sh when it signs. -->
<plist version="1.0">
<dict>
	<key>com.apple.security.cs.allow-jit</key>
	<true/>
</dict>
</plist>
